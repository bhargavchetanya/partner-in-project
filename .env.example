# ------------------------------------------------------------------
# Partner in Project — environment variables
# Copy to `.env` in the project root for local development:
#     cp .env.example .env
# In production, set these in the Render dashboard (never commit .env).
# ------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=4000

# Public URL of the app (no trailing slash).
#   Local dev (Vite on 5173 proxies /api to 4000): http://localhost:5173
#   Production (Render):                          https://partner-in-project.onrender.com
APP_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Add a database name before the "?":
#   mongodb+srv://pipadmin:<password>@cluster0.xxxxx.mongodb.net/partner-in-project?retryWrites=true&w=majority
MONGODB_URI=

# Comma-separated emails that become administrators when they log in
ADMIN_EMAILS=you@example.com

# Long random secrets — generate each with:  openssl rand -base64 48
SESSION_JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Google sign-in (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (github.com → Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <APP_URL>/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fine-grained personal access token, public repositories read-only.
# Needed to fetch repo details (languages, dependencies) for username-only links.
GITHUB_SERVER_TOKEN=

# Brevo transactional email (brevo.com → SMTP & API → API keys). EMAIL_FROM must be a verified sender.
# If empty, emails are printed in the server log and OTP codes are shown in the UI (development only).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Partner in Project

# Development only: show OTP codes / reset links in the UI when email is not configured
EXPOSE_DEV_CODES=true
