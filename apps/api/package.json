{
  "name": "@pip/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seedDemo.ts",
    "make-admin": "tsx --env-file-if-exists=../../.env src/scripts/makeAdmin.ts"
  },
  "dependencies": {
    "@pip/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@pip/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  }
}
